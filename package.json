{
  "name": "markdown2anything",
  "displayName": "Markdown2Anything — 一篇 Markdown 一键发到微信/知乎/小红书/Twitter",
  "description": "写完一篇 Markdown，一键发布到微信公众号、知乎、小红书、Twitter(X)：自动截长图、AI 生成平台文案与串推、自动传图填字。支持 LaTeX 公式、10 套主题、实时预览。",
  "version": "3.4.7",
  "publisher": "marsggbo",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#2d7a3e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other",
    "Formatters"
  ],
  "keywords": [
    "markdown",
    "markdown2anything",
    "wechat",
    "微信公众号",
    "小红书",
    "xiaohongshu",
    "知乎",
    "zhihu",
    "twitter",
    "X",
    "社交媒体",
    "一键发布",
    "publish",
    "AI",
    "LLM",
    "文案生成",
    "LaTeX",
    "KaTeX",
    "preview",
    "export"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/marsggbo/markdown2anything"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:markdown",
    "onCommand:markdown2anything.preview",
    "onCommand:markdown2anything.convert"
  ],
  "contributes": {
    "commands": [
      {
        "command": "markdown2anything.preview",
        "title": "预览微信公众号效果",
        "category": "markdown2anything",
        "icon": {
          "light": "./images/preview-icon.svg",
          "dark": "./images/preview-icon.svg"
        }
      },
      {
        "command": "markdown2anything.convert",
        "title": "导出微信公众号 HTML 文件",
        "category": "markdown2anything",
        "icon": "$(export)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "markdown2anything.preview",
          "when": "resourceLangId == markdown",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "markdown2anything.preview",
          "when": "resourceExtname == .md",
          "group": "1_modification"
        },
        {
          "command": "markdown2anything.convert",
          "when": "resourceExtname == .md",
          "group": "1_modification"
        }
      ],
      "editor/context": [
        {
          "command": "markdown2anything.preview",
          "when": "resourceLangId == markdown",
          "group": "1_modification"
        }
      ]
    },
    "keybindings": [
      {
        "command": "markdown2anything.preview",
        "key": "ctrl+shift+w",
        "mac": "cmd+shift+w",
        "when": "resourceLangId == markdown"
      }
    ],
    "configuration": {
      "title": "Markdown2Anything",
      "properties": {
        "markdown2anything.appid": {
          "type": "string",
          "default": "",
          "description": "微信公众号 AppID（用于上传草稿箱，通过 FastPen 服务）"
        },
        "markdown2anything.appSecret": {
          "type": "string",
          "default": "",
          "description": "微信公众号 AppSecret（用于上传草稿箱，通过 FastPen 服务）"
        },
        "markdown2anything.author": {
          "type": "string",
          "default": "",
          "description": "默认作者名称"
        },
        "markdown2anything.digest": {
          "type": "string",
          "default": "",
          "description": "默认文章摘要"
        },
        "markdown2anything.template": {
          "type": "string",
          "default": "wechat",
          "description": "模板名称（可在工作区 templates/ 目录下放置同名 .html 模板）"
        },
        "markdown2anything.outputPath": {
          "type": "string",
          "default": "build",
          "description": "导出 HTML 的目录（相对于工作区根目录）"
        },
        "markdown2anything.llm.baseUrl": {
          "type": "string",
          "default": "https://api.openai.com/v1",
          "description": "文案生成用的 LLM 接口地址（OpenAI 兼容 /chat/completions）。可填 DeepSeek、Claude 中转、本地 Ollama 等任意 OpenAI 格式端点。"
        },
        "markdown2anything.llm.model": {
          "type": "string",
          "default": "gpt-4o-mini",
          "description": "文案生成用的模型名，如 deepseek-chat、gpt-4o、claude-sonnet-4 等。"
        },
        "markdown2anything.llm.profiles": {
          "type": "string",
          "default": "[]",
          "description": "已保存的 LLM 多配置列表（JSON 字符串，由插件内部维护，请勿手改）。"
        },
        "markdown2anything.llm.activeProfile": {
          "type": "string",
          "default": "",
          "description": "当前激活的 LLM 配置 ID（由插件内部维护，请勿手改）。"
        },
        "markdown2anything.twitter.backend": {
          "type": "string",
          "enum": [
            "playwright",
            "web-intent"
          ],
          "default": "playwright",
          "description": "Twitter 发布后端。playwright：注入 cookie 模拟真浏览器自动发布（推荐）；web-intent：打开预填发推框手动发。"
        },
        "markdown2anything.xhs.backend": {
          "type": "string",
          "enum": [
            "playwright",
            "manual"
          ],
          "default": "playwright",
          "description": "小红书发布后端。playwright：注入 cookie 模拟真浏览器自动发布；manual：仅导出长图 + 复制富文本手动发。"
        },
        "markdown2anything.xhs.exportMode": {
          "type": "string",
          "enum": [
            "classic",
            "adaptive"
          ],
          "default": "classic",
          "description": "小红书图片导出模式。classic：保留当前主题样式；adaptive：使用适合 3:4 手机图片阅读的大字体排版。"
        },
        "markdown2anything.xhs.adaptiveUseTheme": {
          "type": "boolean",
          "default": true,
          "description": "手机自适应截图是否跟随预览器主题色。开启则自动使用当前主题的强调色，关闭则固定小红书红 #ff2442。"
        },
        "markdown2anything.cover.imageModel": {
          "type": "string",
          "default": "",
          "description": "封面生图模型（调 /images/generations）。为空则复用 llm.model。例：gpt-image-1 / dall-e-3"
        },
        "markdown2anything.cover.imageSize": {
          "type": "string",
          "default": "1024x1536",
          "description": "封面生图尺寸，3:4 竖版推荐 1024x1536 / 1080x1440"
        },
        "markdown2anything.publish.headless": {
          "type": "boolean",
          "default": false,
          "description": "自动发布时是否隐藏浏览器窗口。关闭（默认）时你能看到发布全过程，出错可手动接管。"
        },
        "markdown2anything.publish.mode": {
          "type": "string",
          "enum": [
            "prepare",
            "auto"
          ],
          "default": "prepare",
          "description": "prepare（默认，推荐）：自动传图 + 自动填文后停下，最后一步「发布」由你在页面上自己点（更稳，发出前还能再核对一遍）；auto：连发布键也自动点（小红书有二次确认弹窗，容易发布失败，不推荐）。"
        }
      }
    }
  },
  "dependencies": {
    "ali-oss": "^6.23.0",
    "cheerio": "^1.0.0-rc.12",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.9.0",
    "html2canvas": "^1.4.1",
    "juice": "^9.1.0",
    "katex": "^0.16.0",
    "marked": "^11.1.1",
    "mathjax-full": "^3.2.1",
    "md5": "^2.3.0",
    "playwright-core": "^1.59.1",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4"
  },
  "scripts": {
    "package": "vsce package",
    "install-ext": "vsce package && \"/Applications/Visual Studio Code.app/Contents/Resources/app/bin/code\" --install-extension \"markdown2anything-$(node -p \"require('./package.json').version\").vsix\"",
    "publish": "vsce publish",
    "start:electron": "electron ./electron/main.js",
    "build:mac": "electron-builder --mac",
    "build:mac:universal": "electron-builder --mac --universal",
    "test": "node test/run.js",
    "test:syntax": "node test/run.js syntax",
    "test:ui": "node test/run.js ui"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.2",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  }
}
