{
  "id": "cnblogs-metaweblog-v1",
  "version": "1",
  "providerPath": "cnblogs-metaweblog",
  "evidence": { "id": "cnblogs-metaweblog", "url": "https://www.cnblogs.com/" },
  "endpoint": { "origin": "https://rpc.cnblogs.com", "pathTemplate": "/metaweblog/{blogSlug}", "blogSlugPattern": "^[A-Za-z0-9-]{1,64}$" },
  "draftSupported": true,
  "autoSupported": false,
  "reviewablePrepareProof": false,
  "limits": { "maxResponseBytes": 8388608, "timeoutMs": 10000, "acceptedMimes": ["image/jpeg", "image/png", "image/gif", "image/webp"], "maxAssetBytes": 8388608 },
  "supportedFields": ["title", "body", "categories", "tags", "allowComments"],
  "commonOptionMappings": {},
  "routes": {
    "getUsersBlogs": { "method": "blogger.getUsersBlogs", "arguments": [{ "literal": "" }, { "secretSlot": "publishing.cnblogs.username" }, { "secretSlot": "publishing.cnblogs.token" }], "timeoutMs": 10000, "maxResponseBytes": 8388608, "retry": "never-after-response-loss", "response": { "blogs": "$.array" }, "success": { "required": ["blogs:array"] }, "fault": { "code": "$.faultCode", "message": "$.faultString" } },
    "newMediaObject": { "method": "metaWeblog.newMediaObject", "arguments": [{ "source": "account.blogId" }, { "secretSlot": "publishing.cnblogs.username" }, { "secretSlot": "publishing.cnblogs.token" }, { "struct": { "name": { "source": "asset.filename" }, "type": { "source": "asset.mime" }, "bits": { "source": "asset.bytes", "encode": "base64" } } }], "timeoutMs": 10000, "maxResponseBytes": 8388608, "retry": "never-after-response-loss", "acceptedMimes": ["image/jpeg", "image/png", "image/gif", "image/webp"], "maxAssetBytes": 8388608, "response": { "url": "$.url" }, "success": { "required": ["url:absoluteHttps"] }, "fault": { "code": "$.faultCode", "message": "$.faultString" } },
    "newPost": { "method": "metaWeblog.newPost", "arguments": [{ "source": "account.blogId" }, { "secretSlot": "publishing.cnblogs.username" }, { "secretSlot": "publishing.cnblogs.token" }, { "source": "post.struct" }, { "literal": false }], "timeoutMs": 10000, "maxResponseBytes": 8388608, "retry": "never-after-response-loss", "response": { "postId": "$.string" }, "success": { "required": ["postId:nonEmptyString"] }, "fault": { "code": "$.faultCode", "message": "$.faultString" } },
    "getRecentPosts": { "method": "metaWeblog.getRecentPosts", "arguments": [{ "source": "account.blogId" }, { "secretSlot": "publishing.cnblogs.username" }, { "secretSlot": "publishing.cnblogs.token" }, { "literal": 20 }], "timeoutMs": 10000, "maxResponseBytes": 8388608, "retry": "never-after-response-loss", "response": { "posts": "$.array" }, "success": { "required": ["posts:array"] }, "fault": { "code": "$.faultCode", "message": "$.faultString" } }
  }
}
