{
  "id": "zhihu-official-article-v1",
  "version": "1",
  "providerPath": "zhihu-official",
  "evidence": {
    "id": "zhihu-publisher-article-openapi",
    "url": "https://github.com/zhihu/ZhihuSync/blob/main/zhihu-publish/reference/publish-article.md"
  },
  "draftSupported": false,
  "autoSupported": false,
  "limits": {
    "timeoutMs": 10000,
    "maxResponseBytes": 1048576,
    "acceptedMimes": ["image/jpeg", "image/png", "image/gif", "image/webp"],
    "maxAssetBytes": 8388608
  },
  "supportedFields": ["title", "body", "commentPermission", "topics", "tableOfContents", "creationDeclaration"],
  "optionMappings": {
    "commentPermission": { "requestField": "content.comment_permission" },
    "topics": { "requestField": "content.topics" },
    "tableOfContents": { "requestField": "content.table_of_contents_enabled" },
    "creationDeclaration": { "requestField": "content.creation_statement" }
  },
  "routes": {
    "publish": {
      "method": "POST",
      "origin": "https://openapi.zhihu.com",
      "path": "/openapi/publish",
      "timeoutMs": 10000,
      "maxResponseBytes": 1048576,
      "retry": "never-after-response-loss",
      "response": { "status": "$.status", "contentToken": "$.data.content_token", "url": "$.data.url" },
      "success": { "status": "equals-zero", "required": ["contentToken:nonEmptyString", "url:absoluteHttps"] }
    }
  }
}
