# ── 版本控制 ─────────────────────────────────────────────────────────────────
.git/
.gitignore
.github/

# ── 编辑器配置 ────────────────────────────────────────────────────────────────
.vscode/
.DS_Store

# ── Python 环境（扩展不需要） ─────────────────────────────────────────────────
.venv/
**/__pycache__/
*.py
*.pyc

# ── 测试 / 临时文件 ───────────────────────────────────────────────────────────
test.md
test_xhs/

# ── 构建产物 ──────────────────────────────────────────────────────────────────
*.vsix
out/
dist/
build/

# ── 依赖锁文件（运行时不需要） ──────────────────────────────────────────────────
package-lock.json

# ── 开发专用 node_modules（运行时不需要） ───────────────────────────────────────
node_modules/@vscode/
node_modules/@vscode/vsce/
node_modules/@azure/
node_modules/@typespec/
node_modules/.package-lock.json
node_modules/.cache/

# ── mathjax-full：只需 js/，不需要 ES5 转译版本和 TS 源码 ──────────────────────
node_modules/mathjax-full/es5/
node_modules/mathjax-full/ts/

# ── highlight.js：只需 CommonJS 版本，不需要 ES Module 和 SCSS 源码 ───────────
node_modules/highlight.js/es/
node_modules/highlight.js/scss/

# ── katex：只需 dist/（CSS+字体），不需要 TS 源码 ─────────────────────────────
node_modules/katex/src/

# ── Electron 客户端（VS Code 插件不需要） ─────────────────────────────────────
electron/
electron-builder.yml
node_modules/electron/
node_modules/electron-builder/
node_modules/@electron/

# ── 运行时不需要：sourcemap / 测试 / 文档 ───────────────────────────────────────
**/*.map
node_modules/mathjax-full/components/
node_modules/speech-rule-engine/
docs/
node_modules/playwright-core/lib/vite/
icon.png.bak
node_modules/highlight.js/styles/*.css
!node_modules/highlight.js/styles/github.css
!node_modules/highlight.js/styles/github.min.css

# ── 运行时不需要的冗余文件（瘦身，经逐一验证） ──────────────────────────────────
node_modules/katex/dist/katex.mjs
node_modules/katex/dist/contrib/
node_modules/katex/dist/katex.min.js
node_modules/html2canvas/dist/lib/
node_modules/html2canvas/dist/types/
node_modules/html2canvas/dist/html2canvas.js
node_modules/html2canvas/dist/html2canvas.esm.js
node_modules/ali-oss/dist/
node_modules/playwright-core/types/
node_modules/playwright-core/lib/mcpBundle.js
node_modules/playwright-core/lib/mcpBundleImpl.js
